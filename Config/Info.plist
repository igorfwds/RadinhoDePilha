<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Custom keys only. Everything else (scene manifest, orientations, display name) is
	     still generated by GENERATE_INFOPLIST_FILE and merged on top of this file.

	     Xcode expands $(...) here at build time, which is how the value defined in
	     Config/Secrets.xcconfig reaches the running app without ever being written in source
	     code. Custom keys cannot travel via INFOPLIST_KEY_* build settings: Xcode only
	     honours those for keys it already knows about. -->
	<key>APIFootballKey</key>
	<string>$(API_FOOTBALL_KEY)</string>
</dict>
</plist>
