// Secrets.example.xcconfig
//
// Template committed to version control. Copy it to Secrets.xcconfig, which is ignored by
// git, and fill in the real value there:
//
//     cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig
//
// Get a key from the API-Sports dashboard, https://dashboard.api-football.com
//
// Not from RapidAPI: the app calls API-Sports directly, at v3.football.api-sports.io with the
// x-apisports-key header. A RapidAPI key goes to a different host with different headers, and
// would be rejected here.

API_FOOTBALL_KEY =

// Token from https://my.sportmonks.com. When set, the app uses Sportmonks instead of
// API-Football; leave it empty to go back.
SPORTMONKS_TOKEN =
